// missing element on the array :
// input : [3,0,1]
// output : 2


// solution (1)
class Solution {
    public int missingNumber(int[] nums) {
        // Optimize Approaches : 
        // Time Complexity : O(n)
        // Space Complexity : O(1)

     int n = nums.length;
     //Sabse pehle 'n' ko le liya (kyunki loop 0 to n-1 chalega) 
      int miss_num = n ;
      // 0 to n-1 takk akk loop chalega :
      for(int i=0;i<n;i++){
         miss_num = miss_num ^ i ^ nums[i];
      }

        return miss_num;

    }
}

// solution (2)
// Better Approches : 
class Solution {
    public int missingNumber(int[] nums) {
        int n = nums.length;
        // HashSet where used the stored the singal value 

        // HashSet : singal value jab used hota hai tab HashSet used hota hai (like number,password,single integer)(duplicate na hoo)

        // HashMap : jab appko pair me data check karna ho (like naam or number,roll num or nam)

        HashSet<Integer> arr = new HashSet<>();
        for(int i=0;i<n;i++){
            arr.add(nums[i]);
        }
        for(int i=0;i<=n;i++){
         if(!arr.contains(i)){
            return i;
         }
        }
         return -1;
        
    }
}


// solution (3)
// Bruteforce Approaches : 
class Solution {
    public int missingNumber(int[] nums) {
        // Bruteforce Approaches will be :
        // Time Complexity : O(N)^2 
        // Space Complexity : O(1) 

      // Dry run : 
      //[3,0,1] ===> 
      // i=0 => nums[0]=3,nums[1]=0,nums[2]=1 ==> yes '0' are present 
      // i=1 => nums[0]=0 ,nums[1]=0,nums[2]=1 ==> yes '1' are present 
      // i=2 => nums[0]=3,nums[1]=0,nums[2]=1 ==> no '2' are not present
      // i=3 => nums[0]=3,nums[1]=0,nums[2]=1 ==> yes '3' are present 
      // output : 2 

        int n = nums.length;

        for(int i=0;i<=n;i++){
           boolean miss_num = false ;

         for(int j=0;j<n;j++){
            if(nums[j]==i){
              miss_num = true ;
           }
        }

        if(miss_num!=true){
            return i;
        }
     }

     // Dummy output :
     return -1;
    }
}


// solution (4)
// thats approaches are good but in bigger value like n=10^5 so they used the long and such 
class Solution {
    public int missingNumber(int[] nums) {
        // Optimize Approaches : 
        int sum =0;
        int n = nums.length;
        // sum of n th number : 
        int sum_N = n*(n+1)/2;

        for(int i=0;i<n;i++){
            sum+=nums[i];
        }
         
         int miss_num=sum_N-sum;


        return miss_num;
    }
}


